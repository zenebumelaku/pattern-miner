# Copy this file to .env and replace the placeholder with your Gemini key.
# The application loads .env for both normal and experiment CLI modes.
# Shell environment variables take precedence over values in this file.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Leave unset to use Google's native generateContent endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent
